# Copie este arquivo para ".env" (sem o ".example") e preencha os valores.
# O .env nunca deve ir para o Git — já está no .gitignore.

# ---------------------------------------------------------------------
# Geral
# ---------------------------------------------------------------------

# Chave usada para assinar o cookie de sessão. Gere uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Se deixar em branco, uma chave aleatória é gerada a cada vez que o
# processo sobe — o que derruba a sessão de todo mundo a cada restart.
# Preencha isso antes de usar em produção.
SECRET_KEY=

# Onde o arquivo do banco SQLite fica salvo.
DATABASE_PATH=instance/inventario.db

HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=true

# ---------------------------------------------------------------------
# Autenticação
# ---------------------------------------------------------------------

# "mock"      -> login local, sem Microsoft, só para desenvolvimento.
# "microsoft" -> login real via Microsoft Entra ID.
AUTH_MODE=mock

# Só usado quando AUTH_MODE=microsoft. Ver AZURE_SETUP.md para como
# conseguir estes três valores no portal do Azure.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Normalmente o "ID do diretório (locatário)" da SUA empresa (login
# restrito a quem tem conta nesse tenant específico — é o caso de uso
# padrão: sistema interno de uma única empresa).
# Se este sistema for vender para VÁRIAS empresas diferentes (cada uma
# logando com a própria conta Microsoft), troque o valor por:
#   MICROSOFT_TENANT_ID=organizations
# Isso aceita login de qualquer empresa com Microsoft 365 — cada cliente só
# precisa consentir uma vez, sem criar cadastro próprio no Azure. Ver
# AZURE_SETUP.md, seção "Multi-tenant" para os detalhes e cuidados.
MICROSOFT_TENANT_ID=

# Papel dado a partir do SEGUNDO usuário que logar (o primeiro sempre vira
# ADMIN automaticamente — ver README, seção "Primeiro acesso").
PAPEL_PADRAO_NOVO_USUARIO=CONSULTA

# ---------------------------------------------------------------------
# Sincronização com a planilha do SharePoint / OneDrive
# ---------------------------------------------------------------------

# Deixe "false" para usar o sistema só com o banco local, sem mexer em
# planilha nenhuma — dá pra ligar isso depois, quando estiver pronto.
SHAREPOINT_SYNC_ENABLED=false

# Descubra DRIVE_ID e ITEM_ID rodando:
#   python scripts/resolver_sharepoint_ids.py "<link da sua planilha>"
SHAREPOINT_DRIVE_ID=
SHAREPOINT_ITEM_ID=

# Nome da aba e da Tabela (Inserir > Tabela no Excel) dentro da planilha.
SHAREPOINT_WORKSHEET_NAME=Estoque
SHAREPOINT_TABLE_NAME=TabelaEstoque

# Credenciais para o processo de sincronização em segundo plano (fluxo
# "app-only", sem usuário interativo). Por padrão, reaproveita as
# MICROSOFT_* de cima — só preencha estas se quiser usar um app registrado
# diferente para a sincronização.
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_TENANT_ID=
